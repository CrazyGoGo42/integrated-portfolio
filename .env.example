# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and must never be committed.

# Database connection (an existing MySQL/MariaDB server)
DB_HOST=your.db.host
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASS=change_me

# Bearer token required for admin/API write operations
ADMIN_TOKEN=change_me_to_a_long_random_string

# development = verbose errors; production = errors hidden
ENVIRONMENT=production
